extend layout

mixin  client(cliente, clases)
    div.client(
        class=clases
        client_id=cliente._id,
        silla=cliente.silla,
        nturno = cliente.nturno,
        name=cliente.name )

        div(class="client-info")
            strong
                div(class='client-nturno')=cliente.nturno
            div(class='client-name')=cliente.name

        block

mixin declineBtn(cliente)
    div(class="decline-client-button", client_id=cliente._id, silla=cliente.silla)
        div(class="arrow1")
        div(class="arrow2")


mixin desdeclineBox(cliente)
    div(class='desdecline-box')
        div(class='client-text')
            span Declinado
        div(class= 'desdecline-button', client_id=cliente._id, silla=cliente.silla)
            div(class='circular-button')


block script



block linkCss
    // link(rel='stylesheet', href='/stylesheets/style.css')
    link(rel='stylesheet', href='/stylesheets/panel-css/panel.css')
    link(rel='stylesheet', href='/stylesheets/panel-css/frm-addclient.css')
    link(rel='stylesheet', href='/stylesheets/panel-css/frm-abrir-silla.css')
    link(rel='stylesheet', href='/stylesheets/panel-css/frm-logout.css')
    link(rel='stylesheet', href='/stylesheets/panel-css/client-style.css')
    link(rel='stylesheet', href='/stylesheets/panel-css/edit-clients.css')









block content
    div(class="screen logout")
        div(class="logout-card-box")
            div(class="logout-text")
                p Estas seguro que quieres cerrar sesion?
            div(class="logout-button-box")
                div(class="logout-no-close") No
                div(class="logout-close") Si
    header
        div(class="btn-AddClient-box")
            img(src="/images/nuevo-cliente.png", alt="" class="icon")
            div Bienvenido #{username}
        div(class="logout-box")
            img(src="/images/cerrar-sesion.png", alt="" class="icon openLogoutScreenButton")

    article
        div(class="btns-sillas")
            each plq in peluqueros
                div(class="btn-silla" silla=plq.silla) Silla #{plq.silla}



        each plq in peluqueros
            div(class = "plq-div" silla=plq.silla)


                div.top-plq
                    div(class="open-box", silla=plq.silla, open=plq.open)
                        div(id="outer-circle" class=plq.open === 1 ? "green-outer" : "red-outer",)
                            div(id="inner-circle" class=plq.open === 1 ? "green-inner" : "red-inner",)
                        div(id="open-text" ) #{ plq.open === 1 ? "Abierto" : "Cerrado" }

                    div(class="turno-box")
                        div(class="turno-text") Turno actual:
                        div(class="turno" silla=plq.silla)= plq.turnoNow


                div(class="clients-container" silla=plq.silla)

                    each cliente in clientes
                        if cliente.silla === plq.silla

                            case cliente.status
                                when 'esperando'
                                    if cliente.nturno === plq.turnoNow
                                        +client(cliente, "ACTUAL")
                                            +declineBtn(cliente)
                                    else
                                        +client(cliente, "")
                                            +declineBtn(cliente)

                                when 'declinado'
                                   +client(cliente, ["DECLINADO", "declinado"])
                                        +desdeclineBox(cliente)

                                when 'listo'
                                     +client(cliente, ["GREEN"])
                                        div(class='client-text') listo


                div(class="buttons-updown-box")
                    div(class="button-downturn" silla=plq.silla)
                        div(class="line")

                    div(class="button-upturn", silla=plq.silla)
                        div(class="line line-vertical")




    div(class=' frm frmContainer')
        div(class="frmAddClient")
            div
                p  Ingresar nuevo cliente
            div(class="box-input-text")
                input(type="text" class="input-addclient" placeholder="Nombre")
            div
                input(type="button" class="btn-addClient" value="Agregar" data-silla="")

    div(class='frm frmContainer-not-open')
        div(class='sub-frm')
            div(class='not-open-text')
                | La silla
                span  no
                |  esta abierta.
            div(class="ok-button") Aceptar

    div.edit-client-box.edit-name.screen(data-client_id='')
        div.input-name-box
            div.input-name-ttl Cambiar Nombre
            div.input-name-subbox
                div.past-name-container
                    span Anterior:
                    div.past-name

                div.input-new-name-container
                    span Nuevo:
                    input(type='text' id="new-name")
                    div(id="btn-change-name") Actualizar

    



    div.edits-btns-options
        div.change-name-btn.edit-options-btn(data-client_id='')
                span Editar Nombre
        


    script(type="module" src="javascripts/panel-js/PB-panel.js")
    script(type="module" src="javascripts/panel-js/PB-panelTabs.js")
        script(type="module" src="javascripts/panel-js/PB-edit-client.js")
