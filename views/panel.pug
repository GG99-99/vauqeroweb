extend layout 


block script 
     


block linkCss 
    link(rel='stylesheet', href='/stylesheets/style.css')
    link(rel='stylesheet', href='/stylesheets/panel-css/panel.css')
    link(rel='stylesheet', href='/stylesheets/panel-css/frm-addclient.css')
    link(rel='stylesheet', href='/stylesheets/panel-css/frm-abrir-silla.css')
    link(rel='stylesheet', href='/stylesheets/panel-css/frm-logout.css')
    link(rel='stylesheet', href='/stylesheets/panel-css/client-style.css')






block content 
    div(class="logout-screen")
        div(class="logout-card-box")
            div(class="logout-text")
                p Estas seguro que quieres cerrar sesion? 
            div(class="logout-button-box")
                div(class="logout-no-close") No 
                div(class="logout-close") Si 
    header 
        div(class="btn-AddClient-box")
            img(src="/images/nuevo-cliente.png", alt="" class="icon") 
        div(class="logout-box")
            img(src="/images/cerrar-sesion.png", alt="" class="icon openLogoutScreenButton")

    article
        div(class="btns-sillas")
            each plq in peluqueros
                div(class="btn-silla" silla=plq.silla) Silla #{plq.silla}



        each plq in peluqueros
            div(class = "plq-div" silla=plq.silla)


                div.top-plq
                    div(class="open-box", silla=plq.silla, open=plq.open)
                        div(id="outer-circle" class=plq.open === 1 ? "green-outer" : "red-outer",)
                            div(id="inner-circle" class=plq.open === 1 ? "green-inner" : "red-inner",)
                        div(id="open-text" ) #{ plq.open === 1 ? "Abierto" : "Cerrado" }

                    div(class="turno-box")
                        div(class="turno-text") Turno actual:
                        div(class="turno" silla=plq.silla)= plq.turnoNow

                div(class="list-client-box")
                    ul(class="clients-container" silla=plq.silla)

                        each cliente in clientes
                            if cliente.silla === plq.silla

                                case cliente.status
                                    when 'esperando'
                                        li.list-client-li(class=cliente.nturno === plq.turnoNow ? "ACTUAL": " " , nturno = cliente.nturno, cliente_id=cliente._id, silla=cliente.silla)

                                            div(class="li_client-information")
                                                strong
                                                    div(class='cliente-turno-div')=cliente.nturno
                                                div(class='cliente-name-div')=cliente.name
                                            div(class="decline-client-button", cliente_id=cliente._id, silla=plq.silla)
                                                div(class="arrow1")
                                                div(class="arrow2")

                                    when 'declinado'
                                       li(class="list-client-li OPASITY30 declinado", nturno=cliente.turno, cliente_id=cliente._id, silla=cliente.silla)
                                            div(class="li_client-information")
                                                strong
                                                    div(class='cliente-turno-div')=cliente.nturno
                                                div(class='cliente-name-div')=cliente.name

                                            div(class='desdecline-box')
                                                div(class='client-text')
                                                    span Declinado
                                                div(class= 'desdecline-button', cliente_id=cliente._id, silla=cliente.silla)
                                                    div(class='circular-button')

                                    when 'listo'
                                         li(class="list-client-li GREEN" nturno = cliente.nturno, cliente_id=cliente._id, silla=cliente.silla)
                                            div(class="li_client-information")
                                                strong
                                                    div(class='cliente-turno-div')=cliente.nturno
                                                div(class='cliente-name-div')=cliente.name
                                            div(class='client-text') listo


                div(class="buttons-updown-box")
                    div(class="button-downturn" silla=plq.silla)
                        div(class="line")

                    div(class="button-upturn", silla=plq.silla)
                        div(class="line line-vertical")



    footer

    div(class='frmContainer')
        div(class="frmAddClient")
            div
                p(class="p-addclient")  Ingresar nuevo cliente
            div(class="box-input-text")
                input(type="text" class="input-addclient" placeholder="Nombre")
            div
                input(type="button" class="btn-addClient" value="Agregar" data-silla="")

    div(class='frmContainer-not-open')
        div(class='sub-frm')
            div(class='not-open-text')
                | La silla
                span  no
                |  esta abierta.
            div(class="ok-button") Aceptar

    script(type="module" src="javascripts/PB-panel.js")
    script(type="module" src="javascripts/PB-panelTabs.js")
      
     